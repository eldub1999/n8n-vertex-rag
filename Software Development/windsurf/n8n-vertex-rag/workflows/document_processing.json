          "parameters": {
            "temperature": 0.2,
            "maxOutputTokens": 1024,
            "topP": 0.8,
            "topK": 40
          }
        },
        "options": {}
      },
      "name": "Process with Vertex AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 5,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "resource": "database",
        "operation": "executeQuery",
        "query": "WITH inserted_document AS (\\n  INSERT INTO documents (original_name, processed_text, created_at, source_type)\\n  VALUES ($1, $2, NOW(), 'google_drive')\\n  RETURNING id\\n)\\nSELECT id FROM inserted_document",
        "queryParams": "={{{ \n  \"$1\": $node[\\\"Get File from Google Drive\\\"].json[\\\"name\\\"],\\n  \"$2\": $node[\\\"Process with Vertex AI\\\"].json[\\\"predictions\\\"][0][\\\"content\\\"]\\n}}}}"
      },
      "name": "Store in Supabase",
