            {
              "content": "=Convert the following document into well-structured, RAG-optimized markdown. Include clear section headers, bullet points, and preserve all key information while removing any redundant or unnecessary content:\\n\\n{{$node[\\\"Get File from Google Drive\\\"].json[\\\"file\\\"]}}"
            }
