    {
      "parameters": {
        "authentication": "serviceAccount",
        "resource": "database",
        "operation": "executeQuery",
        "query": "INSERT INTO document_embeddings (document_id, embedding, chunk_index, metadata)\\nVALUES ($1, $2, $3, $4)",
        "queryParams": "={{{ \n  \"$1\": $node[\\\"Store in Supabase\\\"].json[\\\"data\\\"][0][\\\"id\\\"],\\n  \"$2\": $node[\\\"Generate Embeddings\\\"].json[\\\"predictions\\\"][0][\\\"embeddings\\\"][\\\"values\\\"],\\n  \"$3\": 0,\\n  \"$4\": {\\n    \"source\\\": \\\"google_drive\\\",\\n    \"original_name\\\": $node[\\\"Get File from Google Drive\\\"].json[\\\"name\\\"],\\n    \"processed_at\\\": \\\"{{$now;}}\\\"\\n  }\\n}}}}"
      },
