      "name": "Any Files?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        250,
        450
      ]
    },
    {
      "parameters": {
        "functionCode": "// This function will be called for each item which\\n// passes the 'Any Files?' node.\\nconst items = [];\\n\\nfor (const file of items[0].json.files) {\\n  items.push({\\n    json: {\\n      fileId: file.id,\\n      name: file.name,\\n      mimeType: file.mimeType\\n    }\\n  });\\n}\\n\\nreturn items;"
      },
      "name": "Prepare Files for Processing",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
